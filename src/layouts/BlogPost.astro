---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagBadge from '../components/TagBadge.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import BuyBox from '../components/BuyBox.astro';
import '../styles/global.css';
import '../styles/prose.css';

type Props = CollectionEntry<'blog'>['data'] & { tags?: string[] };

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: 'Vamos Jogando' },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead {title} {description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      main { width: 100%; max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
      .article-container { padding: 2.5rem; margin-top: 1.5rem; }
      .hero-image {
        width: 100%; margin-bottom: 2rem; border-radius: 12px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), var(--shadow-glow-purple);
        border: 1px solid rgba(139, 92, 246, 0.2);
      }
      .hero-image img { display: block; width: 100%; height: auto; object-fit: cover; }
      .title-section { text-align: center; margin-bottom: 2.5rem; }
      .date {
        color: var(--text-muted); font-size: 0.95rem; font-weight: 600;
        margin-bottom: 0.75rem; display: flex; justify-content: center;
        align-items: center; gap: 0.5rem; flex-wrap: wrap;
      }
      .updated-date { font-style: italic; color: var(--neon-cyan); }
      .article-title {
        font-size: 2.85rem; font-weight: 800; margin-bottom: 1.25rem; line-height: 1.15;
        background: linear-gradient(135deg, #ffffff 30%, #e2e8f0 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      }
      .article-desc {
        font-size: 1.15rem; color: var(--text-secondary); max-width: 700px;
        margin: 0 auto; line-height: 1.5;
      }
      .tags-section { display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.5rem; }
      @media (max-width: 768px) {
        .article-container { padding: 1.25rem; }
        .article-title { font-size: 2rem; }
        .article-desc { font-size: 1rem; }
      }
      @media (max-width: 480px) {
        .article-container { padding: 0.75rem; margin-top: 0.75rem; border-radius: 12px; }
        .article-title { font-size: 1.5rem; }
        .article-desc { font-size: 0.95rem; }
        .date { font-size: 0.8rem; }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article class="glass-panel article-container">
        {heroImage && (
          <div class="hero-image">
            <Image width={1020} height={510} src={heroImage} alt="" />
          </div>
        )}
        <div class="title-section">
          <div class="date">
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span class="updated-date">
                (Atualizado em <FormattedDate date={updatedDate} />)
              </span>
            )}
          </div>
          <h1 class="article-title">{title}</h1>
          <p class="article-desc">{description}</p>
          {tags && tags.length > 0 && (
            <div class="tags-section">
              {tags.map(t => <TagBadge tag={t} />)}
            </div>
          )}
          <hr />
        </div>
        <div class="prose">
          <slot />
        </div>
        <AffiliateDisclosure />
        <BuyBox produto={title} />
      </article>
    </main>
    <Footer />
  </body>
</html>
