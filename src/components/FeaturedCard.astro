---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
---

<section>
  <div class="section-header">
    <h2 class="section-title">Destaque</h2>
  </div>
  <div class="featured-card glass-panel glow-cyan">
    <div class="featured-img-container">
      {post.data.heroImage && (
        <Image width={800} height={450} src={post.data.heroImage} alt="" />
      )}
    </div>
    <div class="featured-content">
      <div class="featured-date">
        <FormattedDate date={post.data.pubDate} />
      </div>
      <h3 class="featured-title">{post.data.title}</h3>
      <p class="featured-desc">{post.data.description}</p>
      <a href={`/blog/${post.id}/`} class="btn-read">
        Ler Artigo
        <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
    overflow: hidden;
  }
  .featured-img-container {
    width: 100%;
    height: 100%;
    min-height: 300px;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }
  .featured-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .featured-card:hover .featured-img-container img {
    transform: scale(1.03);
  }
  .featured-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1.5rem;
  }
  .featured-date {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .featured-title {
    font-size: 2.25rem;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #ffffff;
  }
  .featured-card:hover .featured-title {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .featured-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }
  .btn-read {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.95rem;
    color: #ffffff;
    background: var(--accent-gradient);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    width: fit-content;
    box-shadow: var(--shadow-glow-purple);
  }
  .btn-read:hover {
    background: var(--accent-gradient-hover);
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.4);
    color: #ffffff;
    transform: translateY(-2px);
  }
  @media (max-width: 900px) {
    .featured-card {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .featured-img-container {
      height: 250px;
      min-height: auto;
      border-radius: 12px 12px 0 0;
    }
  }
</style>
