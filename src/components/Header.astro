---
import { SITE_TITLE, SITE_BASE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <nav>
    <div class="logo">
      <a href={SITE_BASE + '/'} class="logo-link">
        <span class="logo-v">V</span>amos<span class="logo-j">J</span>ogando
      </a>
    </div>
    <button class="hamburger" id="menu-toggle" aria-label="Menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <div class="nav-links" id="nav-links">
      <div class="internal-links">
        <HeaderLink href={SITE_BASE + '/'}>Início</HeaderLink>
        <HeaderLink href={SITE_BASE + '/blog'}>Notícias</HeaderLink>
        <HeaderLink href={SITE_BASE + '/reviews'}>Reviews</HeaderLink>
        <HeaderLink href={SITE_BASE + '/search'}>Buscar</HeaderLink>
        <HeaderLink href={SITE_BASE + '/about'}>Sobre</HeaderLink>
      </div>
      <ThemeToggle />
      <div class="social-links">
        <a href="https://www.twitch.tv/vamosjogando" target="_blank" rel="noopener noreferrer" aria-label="Twitch">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.428l-3 3v-3H6.857V1.714h13.714z"/>
          </svg>
        </a>
        <a href="https://www.youtube.com/@vamosjogando" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 0 0 .5 6.19 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81zM9.55 15.57V8.43L15.82 12z"/>
          </svg>
        </a>
        <a href="https://github.com/solutionpaulo/vamosjogando" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('nav-links');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('open');
      document.body.classList.toggle('menu-open');
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 9, 13, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0 1.5rem;
    height: 70px;
  }
  nav {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo-link {
    font-family: var(--font-title);
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.1rem;
    text-shadow: none;
  }
  .logo-link:hover { color: #ffffff; text-shadow: none; }
  .logo-v {
    color: var(--neon-purple);
    text-shadow: 0 0 10px var(--neon-purple-glow);
  }
  .logo-j {
    color: var(--neon-cyan);
    text-shadow: 0 0 10px var(--neon-cyan-glow);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .internal-links { display: flex; gap: 1.5rem; }
  .social-links { display: flex; align-items: center; }
  .social-links a {
    color: var(--text-secondary);
    display: flex; align-items: center;
    padding: 0.5rem; border-radius: 8px;
    border: 1px solid transparent;
  }
  .social-links a:hover {
    color: var(--neon-cyan);
    background: rgba(6, 182, 212, 0.05);
    border-color: rgba(6, 182, 212, 0.2);
    text-shadow: 0 0 8px var(--neon-cyan-glow);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    padding: 8px 10px;
    cursor: pointer;
    z-index: 110;
  }
  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 640px) {
    .site-header { padding: 0 1rem; }
    .logo-link { font-size: 1.2rem; }

    .hamburger { display: flex; }

    .nav-links {
      position: fixed;
      top: 70px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(8, 9, 13, 0.97);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding: 1rem;
      transform: translateY(-120%);
      opacity: 0;
      transition: transform 0.3s ease, opacity 0.3s ease;
      pointer-events: none;
    }
    .nav-links.open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .internal-links {
      flex-direction: column;
      gap: 0;
      width: 100%;
    }
    .internal-links :global(a) {
      display: block;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 1.1rem;
    }
    .social-links {
      padding-top: 0.75rem;
      width: 100%;
      justify-content: center;
    }
    body.menu-open { overflow: hidden; }
  }

  @media (max-width: 380px) {
    .logo-link { font-size: 1rem; }
    .site-header { padding: 0 0.75rem; }
  }
</style>
