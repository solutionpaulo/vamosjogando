---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
  <nav>
    <div class="logo">
      <a href="/" class="logo-link">
        <span class="logo-v">V</span>amos<span class="logo-j">J</span>ogando
      </a>
    </div>
    <div class="internal-links">
      <HeaderLink href="/">Início</HeaderLink>
      <HeaderLink href="/blog">Notícias</HeaderLink>
      <HeaderLink href="/search">Buscar</HeaderLink>
      <HeaderLink href="/about">Sobre</HeaderLink>
    </div>
    <div class="social-links">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 9, 13, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0 1.5rem;
    height: 70px;
  }
  nav {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo-link {
    font-family: var(--font-title);
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.1rem;
    text-shadow: none;
  }
  .logo-link:hover { color: #ffffff; text-shadow: none; }
  .logo-v {
    color: var(--neon-purple);
    text-shadow: 0 0 10px var(--neon-purple-glow);
  }
  .logo-j {
    color: var(--neon-cyan);
    text-shadow: 0 0 10px var(--neon-cyan-glow);
  }
  .internal-links { display: flex; gap: 1.5rem; }
  .social-links { display: flex; align-items: center; }
  .social-links a {
    color: var(--text-secondary);
    display: flex; align-items: center;
    padding: 0.5rem; border-radius: 8px;
    border: 1px solid transparent;
  }
  .social-links a:hover {
    color: var(--neon-cyan);
    background: rgba(6, 182, 212, 0.05);
    border-color: rgba(6, 182, 212, 0.2);
    text-shadow: 0 0 8px var(--neon-cyan-glow);
  }
  @media (max-width: 768px) {
    .site-header { padding: 0 1rem; }
    .logo-link { font-size: 1.25rem; }
    .internal-links { gap: 0.75rem; }
    .social-links { display: none; }
  }
</style>
