---
import { slugifyTag } from '../utils/posts';
import { SITE_BASE } from '../consts';

interface Props {
  tag: string;
  link?: boolean;
  variant?: 'default' | 'cyan';
}

const { tag, link = true, variant = 'default' } = Astro.props;
---

{
  link ? (
    <a href={SITE_BASE + '/blog/tag/' + slugifyTag(tag)} class={`badge ${variant === 'cyan' ? 'badge-cyan' : ''}`}>
      {tag}
    </a>
  ) : (
    <span class={`badge ${variant === 'cyan' ? 'badge-cyan' : ''}`}>
      {tag}
    </span>
  )
}
