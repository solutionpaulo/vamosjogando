---
import { AFFILIATE_ENABLED } from '../affiliates';
---

{AFFILIATE_ENABLED && (
  <div class="disclosure">
    <p>
      Este site contém links de afiliado. Ao comprar através deles,
      você ajuda a manter o <strong>Vamos Jogando</strong> sem custo adicional.
    </p>
  </div>
)}

<style>
  .disclosure {
    background: rgba(139, 92, 246, 0.08);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin: 1.5rem 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-align: center;
  }
  p { margin: 0; }
  strong { color: var(--neon-purple); }
</style>
