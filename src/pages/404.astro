---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_BASE } from '../consts';
---

<BaseLayout title={`Página não encontrada - ${SITE_TITLE}`} description="Página não encontrada">
  <div class="not-found">
    <div class="not-found-code">404</div>
    <h1>Página não encontrada</h1>
    <p>Parece que você se perdeu. Esta página não existe ou foi removida.</p>
    <a href={SITE_BASE + '/'} class="btn-home">Voltar ao Início</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 6rem 1rem;
  }
  .not-found-code {
    font-family: var(--font-title);
    font-size: 8rem;
    font-weight: 800;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1;
    margin-bottom: 1rem;
  }
  .not-found h1 {
    margin-bottom: 1rem;
  }
  .not-found p {
    font-size: 1.15rem;
    max-width: 500px;
    margin: 0 auto 2rem auto;
  }
  .btn-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-title);
    font-weight: 700;
    color: #ffffff;
    background: var(--accent-gradient);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    box-shadow: var(--shadow-glow-purple);
  }
  .btn-home:hover {
    background: var(--accent-gradient-hover);
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.4);
    color: #ffffff;
    transform: translateY(-2px);
  }
</style>
